#include <behaviors/meteorite_custom_key.dtsi>
#include <behaviors/custom_config.dtsi>
#include <behaviors/meteorite_bt_os.dtsi>
#include <behaviors/meteorite_mod_key.dtsi>
#include <behaviors/meteorite_os_key.dtsi>
#include <dt-bindings/zmk/custom_config.h>
#include <dt-bindings/zmk/meteorite_custom_keys.h>
#include <dt-bindings/zmk/meteorite_bt_os.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "tap-preferred"; // change hold to tap
    tapping-term-ms = <200>;
    quick-tap-ms = <150>; // change 200 to 150
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <150>; // change 200 to 150
    quick-tap-ms = <150>; // change 200 to 150
};

/ {
    behaviors {
        mck_mt: mck_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&mck>, <&kp>;

            display-name = "meteorite OS-Switch-mod-tap";
        };

        mck_mt_st: mck_mt_st {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&mck>, <&alt_cmd_tab>;

            display-name = "meteorite OS-Switch-mod-tap (smart toggle)";
        };

        alt_cmd_tab: alt_cmd_tab {
            compatible = "zmk,behavior-smart-toggle";
            #binding-cells = <0>;
            display-name = "meteorite Smart toggle (Alt/Cmd+Tab)";
            bindings = <&mck M_OS_ALT_CMD>, <&kp TAB>;

            position-bindings = <12 13>; /* D, F */
            position-binding-behaviors = <&kp LS(TAB)>, <&kp TAB>;
        };

        enc_msc: encoder_mouse_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <25>;
            display-name = "Encoder Mouse Scroll";
        };

        enc_kp: encoder_key_press {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tap-ms = <25>;
            display-name = "Encoder Key Press";
        };
    };

    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>; /* Z + X */
            layers = <0>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>; /* Q + W */
            layers = <0>;
        };

        Up {
            bindings = <&kp UP>;
            key-positions = <7 8>;
        };

        Down {
            bindings = <&kp DOWN>;
            key-positions = <29 30>;
        };

        Left {
            bindings = <&kp LEFT>;
            key-positions = <16 17>;
        };

        Right {
            bindings = <&kp RIGHT>;
            key-positions = <18 19>;
        };
    };

    macros {
        M1: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp O &kp S &kp H &kp I>;
            label = "NEW_MACRO";
        };

        M2: M2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N2 &kp N5 &kp M &kp B &kp A>;
            label = "M2";
        };

        M3: M3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(M) &kp N3>;
            label = "M3";
        };
    };

    keymap {
        compatible = "zmk,keymap";
        layout = &LAYOUT_2U_SPACE;

        default_layer {
            display-name = "BASE";
            bindings = <
&lt 3 Q             &kp W               &kp E    &kp R               &kp T      &kp Y      &kp U                  &kp I         &kp O  &kp P
&mt LEFT_COMMAND A  &kp S               &kp D    &mt LEFT_COMMAND F  &kp G      &kp H      &kp J                  &kp K         &kp L  &kp MINUS
&mt LEFT_SHIFT Z    &kp X               &kp C    &mt LEFT_COMMAND V  &kp B      &mkp MB1   &mkp MB2               &kp N         &kp M  &kp COMMA  &kp DOT  &mt LEFT_SHIFT SLASH
&lt 4 LEFT_GUI      &lt 1 INT_MUHENKAN  &kp DEL  &kp BACKSPACE       &kp ENTER  &kp SPACE  &lt 2 INTERNATIONAL_4  &kp LEFT_ALT
            >;
        };

        layer_1 {
            display-name = "FuncNum";
            bindings = <
&kp ESC       &kp LC(NUMBER_1)  &kp LG(NUMBER_2)  &kp F4  &kp F5     &kp COLON             &kp N7    &kp N8                 &kp N9  &kp PLUS
&kp TAB       &kp F6            &kp F7            &kp F8  &kp F9     &kp LEFT_PARENTHESIS  &kp N4    &kp N5                 &kp N6  &kp MINUS
&kp LEFT_GUI  &kp TAB           &none             &none   &kp LG(Q)  &mkp MB4              &mkp MB5  &kp RIGHT_PARENTHESIS  &kp N1  &kp N2     &kp N3  &kp ASTERISK
&trans        &trans            &trans            &trans  &trans     &trans                &kp N0    &kp DOT
            >;
        };

        layer_2 {
            display-name = "Symbol";
            bindings = <
&kp EXCLAMATION  &kp AT   &kp HASH        &kp DOLLAR      &kp PERCENT        &kp CARET  &kp AMPERSAND  &kp ASTERISK          &kp LEFT_BRACE    &kp RIGHT_BRACE
&kp TAB          &none    &kp EQUAL       &kp EQUAL       &kp DOUBLE_QUOTES  &kp PLUS   &kp COLON      &kp SEMICOLON         &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp LEFT_GUI     &kp TAB  &kp UNDERSCORE  &kp UNDERSCORE  &kp SQT            &mkp MB4   &mkp MB5       &kp NON_US_BACKSLASH  &kp PIPE          &kp SLASH          &kp LESS_THAN  &kp GREATER_THAN
&trans           &trans   &trans          &trans          &trans             &trans     &trans         &trans
            >;

            sensor-bindings =
                <&enc_kp C_VOL_DN C_VOL_UP>,
                <&enc_kp C_VOL_DN C_VOL_UP>;
        };

        layer_3 {
            display-name = "FUNCTION";
            bindings = <
&none   &none   &none   &kp C_BRIGHTNESS_INC  &kp C_VOL_UP  &kp LG(LC(Q))         &none     &M1                   &M2       &M3
&none   &none   &none   &kp C_BRIGHTNESS_DEC  &kp C_VOL_DN  &kp LS(LG(NUMBER_3))  &kp LEFT  &kp DOWN              &kp UP    &kp RIGHT
&none   &none   &none   &none                 &kp K_MUTE    &none                 &none     &kp LS(LG(NUMBER_4))  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END
&trans  &trans  &trans  &trans                &trans        &trans                &trans    &trans
            >;
        };

        layer_4 {
            display-name = "SETTING";
            bindings = <
&ccfg C_CPI_DN   &ccfg C_CPI_UP   &ccfg C_ROT_DN    &ccfg C_ROT_UP    &ccfg C_SCALE_TOG       &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&ccfg C_SDIV_DN  &ccfg C_SDIV_UP  &ccfg C_SCRH_TOG  &ccfg C_SCRV_TOG  &ccfg C_SCRL_SCALE_TOG  &bt BT_CLR    &bt BT_CLR_ALL  &none         &none         &none
&ccfg C_SAVE     &ccfg C_RESET    &none             &none             &ccfg C_SCRL2_UP        &none         &none           &bootloader   &none         &none         &none  &none
&trans           &trans           &trans            &trans            &trans                  &trans        &trans          &bootloader
            >;
        };
    };
};
